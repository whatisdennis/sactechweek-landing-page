{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": null,
  "installCommand": null,
  "outputDirectory": ".",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/newsletter-signup",
      "destination": "/api/newsletter-signup"
    }
  ],
  "redirects": [
    {
      "source": "/calendar",
      "destination": "https://stw-app-sandy.vercel.app",
      "permanent": false
    },
    {
      "source": "/calendar/:path*",
      "destination": "https://stw-app-sandy.vercel.app/:path*",
      "permanent": false
    }
  ]
}
